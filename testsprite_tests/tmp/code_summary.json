{
  "tech_stack": [
    "TypeScript",
    "React 18",
    "Vite",
    "Tailwind CSS",
    "shadcn/ui",
    "Supabase",
    "PostgreSQL",
    "Capacitor",
    "Stripe",
    "OpenAI GPT-4 Vision",
    "Google Analytics",
    "Vitest"
  ],
  "features": [
    {
      "name": "Authentication System",
      "description": "Complete user authentication with Supabase Auth including sign up, login, email confirmation, and profile management",
      "files": [
        "src/hooks/useAuth.ts",
        "src/pages/Auth.tsx",
        "src/pages/EmailConfirmation.tsx",
        "src/pages/Profile.tsx",
        "src/integrations/supabase/client.ts",
        "src/integrations/supabase/types.ts"
      ],
      "api_doc": {
        "openapi": "3.0.0",
        "info": {
          "title": "Veo Veo Authentication API",
          "version": "1.0.0"
        },
        "paths": {
          "/auth/signup": {
            "post": {
              "summary": "User registration",
              "requestBody": {
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object",
                      "properties": {
                        "email": {"type": "string"},
                        "password": {"type": "string"},
                        "username": {"type": "string"}
                      }
                    }
                  }
                }
              }
            }
          },
          "/auth/login": {
            "post": {
              "summary": "User login",
              "requestBody": {
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object",
                      "properties": {
                        "email": {"type": "string"},
                        "password": {"type": "string"}
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "Game Room Management",
      "description": "Create, join, and manage game rooms with real-time updates using Supabase Realtime",
      "files": [
        "src/pages/CreateRoom.tsx",
        "src/pages/JoinRoom.tsx",
        "src/pages/Room.tsx",
        "src/pages/PublicRooms.tsx",
        "src/lib/gameService.ts"
      ],
      "api_doc": {
        "openapi": "3.0.0",
        "info": {
          "title": "Veo Veo Room Management API",
          "version": "1.0.0"
        },
        "paths": {
          "/rooms": {
            "post": {
              "summary": "Create a new game room",
              "requestBody": {
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object",
                      "properties": {
                        "room_name": {"type": "string"},
                        "max_players": {"type": "integer"},
                        "is_private": {"type": "boolean"},
                        "language": {"type": "string"}
                      }
                    }
                  }
                }
              }
            },
            "get": {
              "summary": "Get public rooms list"
            }
          },
          "/rooms/{roomId}/join": {
            "post": {
              "summary": "Join a game room"
            }
          }
        }
      }
    },
    {
      "name": "Game Engine",
      "description": "Core game logic with photo capture, AI object detection, guessing system, and scoring",
      "files": [
        "src/pages/Game.tsx",
        "src/lib/aiService.ts",
        "src/lib/cameraService.ts",
        "src/hooks/usePlatform.ts"
      ],
      "api_doc": {
        "openapi": "3.0.0",
        "info": {
          "title": "Veo Veo Game Engine API",
          "version": "1.0.0"
        },
        "paths": {
          "/games/{gameId}": {
            "get": {
              "summary": "Get current game state"
            },
            "put": {
              "summary": "Update game state"
            }
          },
          "/games/{gameId}/rounds": {
            "post": {
              "summary": "Create new game round"
            }
          },
          "/games/{gameId}/guesses": {
            "post": {
              "summary": "Submit player guess"
            }
          }
        }
      }
    },
    {
      "name": "Payment System",
      "description": "Stripe integration for premium subscriptions with webhook handling",
      "files": [
        "src/lib/paymentService.ts",
        "src/pages/Premium.tsx"
      ],
      "api_doc": {
        "openapi": "3.0.0",
        "info": {
          "title": "Veo Veo Payment API",
          "version": "1.0.0"
        },
        "paths": {
          "/payments/checkout": {
            "post": {
              "summary": "Create Stripe checkout session",
              "requestBody": {
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object",
                      "properties": {
                        "planId": {"type": "string"},
                        "successUrl": {"type": "string"},
                        "cancelUrl": {"type": "string"}
                      }
                    }
                  }
                }
              }
            }
          },
          "/payments/webhook": {
            "post": {
              "summary": "Handle Stripe webhooks"
            }
          }
        }
      }
    },
    {
      "name": "Social Features",
      "description": "Friends system, leaderboards, and social interactions",
      "files": [
        "src/pages/Friends.tsx",
        "src/pages/Leaderboards.tsx",
        "src/components/Chat.tsx"
      ],
      "api_doc": {
        "openapi": "3.0.0",
        "info": {
          "title": "Veo Veo Social API",
          "version": "1.0.0"
        },
        "paths": {
          "/friends": {
            "get": {
              "summary": "Get user's friends list"
            },
            "post": {
              "summary": "Send friend request"
            }
          },
          "/leaderboards": {
            "get": {
              "summary": "Get leaderboards by category"
            }
          },
          "/chat/messages": {
            "get": {
              "summary": "Get chat messages"
            },
            "post": {
              "summary": "Send chat message"
            }
          }
        }
      }
    },
    {
      "name": "Theme System",
      "description": "Customizable visual themes with premium themes and theme generation",
      "files": [
        "src/lib/themeService.ts",
        "src/index.css"
      ],
      "api_doc": {
        "openapi": "3.0.0",
        "info": {
          "title": "Veo Veo Theme API",
          "version": "1.0.0"
        },
        "paths": {
          "/themes": {
            "get": {
              "summary": "Get available themes"
            }
          },
          "/themes/{themeId}": {
            "put": {
              "summary": "Apply theme"
            }
          },
          "/themes/custom": {
            "post": {
              "summary": "Create custom theme"
            }
          }
        }
      }
    },
    {
      "name": "Offline Mode",
      "description": "Offline functionality with local storage and synchronization",
      "files": [
        "src/lib/offlineService.ts"
      ],
      "api_doc": {
        "openapi": "3.0.0",
        "info": {
          "title": "Veo Veo Offline API",
          "version": "1.0.0"
        },
        "paths": {
          "/offline/photos": {
            "post": {
              "summary": "Save photo offline"
            },
            "get": {
              "summary": "Get offline photos"
            }
          },
          "/offline/sync": {
            "post": {
              "summary": "Sync offline data"
            }
          }
        }
      }
    },
    {
      "name": "Tournament System",
      "description": "Tournament management with registration, scoring, and prizes",
      "files": [
        "src/lib/tournamentService.ts"
      ],
      "api_doc": {
        "openapi": "3.0.0",
        "info": {
          "title": "Veo Veo Tournament API",
          "version": "1.0.0"
        },
        "paths": {
          "/tournaments": {
            "get": {
              "summary": "Get active tournaments"
            },
            "post": {
              "summary": "Create tournament"
            }
          },
          "/tournaments/{tournamentId}/register": {
            "post": {
              "summary": "Register for tournament"
            }
          }
        }
      }
    },
    {
      "name": "Analytics",
      "description": "Google Analytics integration with custom event tracking",
      "files": [
        "src/hooks/useAnalytics.ts",
        "src/components/GoogleAnalytics.tsx",
        "src/components/AnalyticsWrapper.tsx"
      ],
      "api_doc": {
        "openapi": "3.0.0",
        "info": {
          "title": "Veo Veo Analytics API",
          "version": "1.0.0"
        },
        "paths": {
          "/analytics/event": {
            "post": {
              "summary": "Track custom event",
              "requestBody": {
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object",
                      "properties": {
                        "action": {"type": "string"},
                        "category": {"type": "string"},
                        "label": {"type": "string"},
                        "value": {"type": "number"}
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "Mobile App",
      "description": "Native mobile app functionality using Capacitor with camera and haptic feedback",
      "files": [
        "capacitor.config.ts",
        "android/app/src/main/res/values/strings.xml",
        "ios/App/App/Info.plist"
      ],
      "api_doc": {
        "openapi": "3.0.0",
        "info": {
          "title": "Veo Veo Mobile API",
          "version": "1.0.0"
        },
        "paths": {
          "/mobile/camera": {
            "post": {
              "summary": "Take photo using native camera"
            }
          },
          "/mobile/haptics": {
            "post": {
              "summary": "Trigger haptic feedback"
            }
          }
        }
      }
    }
  ]
}
